.level-up-overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    display: flex;
    -unity-font-definition: url("project://database/Assets/UI/Jersey_10/Jersey10-Regular%20SDF.asset");
}

.level-up-title {
    color: #ffffff;
    font-size: 48px;
    margin-bottom: 30px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

.options-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.option-card {
    width: 150px;
    min-height: 220px;
    background-color: #2c3e50; /* A dark, saturated blue-gray */
    border-width: 0;
    padding: 16px;
    align-items: center;
    justify-content: space-between;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
    margin: 0 10px;
    border-radius: 12px;
    
    /* Simulated Drop Shadow using bottom/right border */
    border-bottom-width: 4px;
    border-right-width: 4px;
    border-bottom-color: #1a252f;
    border-right-color: #1a252f;
}

.option-card:hover {
    background-color: #34495e;
    scale: 1.05;
}

.option-title {
    color: #ffffff;
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.option-description {
    color: #bdc3c7;
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    justify-content: center;
    margin: 8px 0;
}

.option-button {
    background-color: #ecf0f1;
    color: #2c3e50;
    border-radius: 6px;
    font-size: 14px;
    padding: 6px;
    width: 100%;
    -unity-text-align: middle-center;
    border-width: 0;
}
