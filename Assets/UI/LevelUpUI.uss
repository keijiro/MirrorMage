.level-up-overlay {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    display: flex;
    -unity-font-definition: url("project://database/Assets/UI/Jersey_10/Jersey10-Regular%20SDF.asset");
}

.level-up-title {
    color: #ffffff;
    font-size: 72px;
    margin-bottom: 45px;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: #000000;
}

.options-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.option-card {
    width: 250px;
    min-height: 330px;
    background-color: #2c3e50;
    border-width: 0;
    padding: 24px;
    align-items: center;
    justify-content: space-between;
    margin: 0 15px;
    border-radius: 18px;
    
    border-bottom-width: 6px;
    border-right-width: 6px;
    border-bottom-color: #1a252f;
    border-right-color: #1a252f;

    /* Transition for entry and selection effects. Added color and tint for smooth fade back. */
    transition-property: translate, scale, opacity, background-color, color, -unity-background-image-tint-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}

/* Initial hidden state (bottom of screen) */
.option-card--hidden {
    translate: 0 600px;
    opacity: 0;
}

/* Selected state: Set to 1.1x as requested. */
.option-card--selected {
    background-color: #3498db;
    scale: 1.1;
    transition-duration: 0.3s;
    border-width: 4px;
    border-color: #ffffff;
}

/* Dimmed state for non-selected buttons */
.option-card--dimmed {
    opacity: 0.4;
    scale: 0.85;
    transition-duration: 0.3s;
}

.option-card:hover {
    background-color: #34495e;
    scale: 1.05;
}

/* Flash state: 1.15x for a small pop, overrides hover/selected. */
.option-card.option-card--flash {
    background-color: #ffffff;
    transition-duration: 0s;
    scale: 1.15;
    border-width: 0;
}

/* Silhouette children during flash */
.option-card.option-card--flash .option-title,
.option-card.option-card--flash .option-description,
.option-card.option-card--flash .option-button,
.option-card.option-card--flash .option-icon {
    opacity: 1;
    color: #000000;
    -unity-background-image-tint-color: #000000;
    transition-duration: 0s;
}

.option-icon {
    width: 120px;
    height: 120px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 15px;
    border-color: #7f8c8d;
    border-width: 3px;
    overflow: hidden;
}

#moveSpeedIcon {
    background-image: url("project://database/Assets/UI/Icons/Icon_MoveSpeed.png?fileID=21300000&guid=e06e5af7f935941b28a8b91a1351d324&type=3");
}

#chargeSpeedIcon {
    background-image: url("project://database/Assets/UI/Icons/Icon_ChargeSpeed.png?fileID=21300000&guid=2819b6a57ebbc472cbb65dd3a0d79f5f&type=3");
}

#barrierStrengthIcon {
    background-image: url("project://database/Assets/UI/Icons/Icon_BarrierStrength.png?fileID=21300000&guid=70c61763409c2406dbbc71bd85f1363c&type=3");
}

.option-title {
    color: #ffffff;
    font-size: 30px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 12px;
}

.option-description {
    color: #bdc3c7;
    font-size: 21px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
    justify-content: center;
    margin: 12px 0;
}

.option-button {
    background-color: #ecf0f1;
    color: #2c3e50;
    border-radius: 9px;
    font-size: 21px;
    padding: 9px;
    width: 100%;
    -unity-text-align: middle-center;
    border-width: 0;
}
