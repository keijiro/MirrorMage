.hud-root {
    flex-grow: 1;
    padding: 10px;
    -unity-font-definition: url("project://database/Assets/UI/Jersey_10/Jersey10-Regular%20SDF.asset");
}

.hud-row {
    margin-bottom: 6px;
}

.hud-label {
    color: #ffffff;
    font-size: 18px;
    margin-bottom: 2px;
}

.bar-container {
    width: 100px;
    height: 6px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: #ffffff;
}

.health-bar-fill {
    height: 100%;
    background-color: #ff4d4d;
}

.xp-bar-fill {
    height: 100%;
    background-color: #4da6ff;
}

.xp-bar-container {
    width: 100px;
    height: 3px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: #ffffff;
    margin-top: 4px;
}

.xp-bar-fill {
    flex-grow: 1;
    background-color: #4da6ff;
}

.xp-bar-container {
    width: 100px;
    height: 3px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: #ffffff;
    margin-top: 4px;
}

.xp-bar-fill {
    flex-grow: 1;
    background-color: #4da6ff;
}

.xp-bar-container {
    width: 100px;
    height: 3px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: #ffffff;
    margin-top: 4px;
}

.xp-bar-fill {
    flex-grow: 1;
    background-color: #4da6ff;
}
